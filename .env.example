# Google Maps API Key (Optional: App falls back to OpenStreetMap / flutter_map if left empty)
MAPS_API_KEY=

# Firebase Configuration (Can also be configured by placing google-services.json in android/app/)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# App Feature Flags
APP_NAME="Blood Donation Finder & Tracker"
DONATION_ELIGIBILITY_DAYS=90
